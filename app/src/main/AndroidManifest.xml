<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The streaming apps Foldman can drive through their media sessions. -->
    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.apple.android.music" />
    </queries>

    <!-- allowBackup / dataExtractionRules: the settings include tokens, so nothing is backed up.
         usesCleartextTraffic: allows connecting to local LAN Plex Media Servers over HTTP as well as HTTPS. -->
    <application
        android:allowNativeHeapPointerTagging="false"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Foldman">

        <!-- Folding and unfolding resizes the window in place so the reels never stop mid-spin. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Spotify OAuth 2.0 PKCE callback (foldman://spotify-callback) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="foldman"
                    android:host="spotify-callback" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- MusicKit's player, kept in its own process so a crash in Apple's native code only
             stops the music; Foldman restarts it and carries on. -->
        <service
            android:name=".apple.ApplePlayerService"
            android:exported="false"
            android:process=":apple" />

        <!-- MusicKit's sign-in callback (musicsdk://dev.foldman/authenticateresult…), opened by the
             Apple Music app when sign-in finishes. The 2021 SDK predates Android 12's exported rule.
             Only takes effect when the MusicKit AARs are in app/libs. -->
        <activity
            android:name="com.apple.android.sdk.authentication.SDKUriHandlerActivity"
            android:exported="true"
            tools:ignore="MissingClass"
            tools:node="merge" />

        <!-- Notification access is what lets Foldman see Spotify's, YT Music's and Apple Music's media sessions. -->
        <service
            android:name=".remote.MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 2x1 Cassette Widget -->
        <receiver
            android:name=".widget.CassetteWidgetProvider"
            android:exported="true"
            android:label="@string/widget_cassette_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cassette_2x1_info" />
        </receiver>

        <!-- 4x2 Walkman Deck Widget -->
        <receiver
            android:name=".widget.DeckControlWidgetProvider"
            android:exported="true"
            android:label="@string/widget_deck_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_deck_4x2_info" />
        </receiver>

        <!-- Widget Transport Action Receiver -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.foldman.action.PLAY_PAUSE" />
                <action android:name="dev.foldman.action.PREV" />
                <action android:name="dev.foldman.action.NEXT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
