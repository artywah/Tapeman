<?xml version="1.0" encoding="utf-8"?>
<!-- Layers are named foldman_icon_* rather than ic_launcher_*: MusicKit's auth AAR ships a template
     drawable-v24/ic_launcher_foreground (the Android robot) that would otherwise replace ours. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/tapeman_icon_background" />
    <foreground android:drawable="@drawable/tapeman_icon_foreground" />
    <monochrome android:drawable="@drawable/tapeman_icon_monochrome" />
</adaptive-icon>
